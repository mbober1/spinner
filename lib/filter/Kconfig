menuconfig SPINNER_FILTER_LOW_PASS
	bool "Low-pass filter backend"
	help
	  Enable low-pass filtering.

if SPINNER_FILTER_LOW_PASS

choice SPINNER_FILTER_LOW_PASS_BACKEND
	prompt "Low-pass filter backend"
	default SPINNER_FILTER_LOW_PASS_BIQUAD

config SPINNER_FILTER_LOW_PASS_BIQUAD
	bool "CMSIS-DSP biquad"
	depends on FPU
	select CMSIS_DSP
	select CMSIS_DSP_FILTERING

endchoice

endif